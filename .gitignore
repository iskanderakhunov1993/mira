# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
.next/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
DerivedData/
.build/
xcuserdata/
*.xcuserstate

# generated Vite config outputs
apps/web/.next/
apps/web/vite.config.js
apps/web/vite.config.d.ts
apps/web/.qa/

# Supabase local runtime
supabase/.branches/
supabase/.temp/

# Stitch handoff downloads
stitch/sources.json
stitch/sources.ru.json
stitch/assets/*
stitch/code/*
stitch/meta/*
stitch/ru/assets/*
stitch/ru/code/*
stitch/ru/meta/*
!stitch/assets/.gitkeep
!stitch/code/.gitkeep
!stitch/meta/.gitkeep
!stitch/ru/assets/.gitkeep
!stitch/ru/code/.gitkeep
!stitch/ru/meta/.gitkeep
